# Chain profile: ethereum | arbitrum
CHAIN=ethereum

# JSON-RPC endpoints (chainlist.org, Alchemy, QuickNode…)
RPC_URL=https://eth.llamarpc.com
WS_URL=

# Starting block: "latest" or a number. An existing checkpoint takes precedence.
START_BLOCK=latest

# Kafka (local Redpanda via docker-compose)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=tx-events
KAFKA_CHECKPOINT_TOPIC=tx-checkpoints

# Address dataset
ADDRESSES_FILE=testdata/addresses.csv

# Log level: debug | info | warn | error
LOG_LEVEL=info
