# JSON-RPC endpoint. Verified working: ethereum-rpc.publicnode.com,
# eth.drpc.org, arb1.arbitrum.io/rpc.
RPC_URL=https://ethereum-rpc.publicnode.com

# How often to ask for a new head once caught up. Mainnet blocks are 12-13s
# apart, Arbitrum blocks 0.25-1s.
POLL_INTERVAL=3s

# Concurrent fetches and blocks per fetch, measured on mainnet: throughput is
# 48 blocks/s at 4 workers, 69 at 8, 76 at 16 and 74 at 32 — the endpoint
# saturates, not us. 8 is the knee: 91% of the ceiling for 278 MB against 376 MB
# at 16.
#
# BATCH_SIZE is bounded by the endpoint's ~24 MB response cap. Mainnet blocks
# average 620 KB, so 20 fits and 50 is refused; Arbitrum blocks are ~100x
# smaller, so 100 is comfortable there.
WORKERS=8
BATCH_SIZE=20

# Where to begin when there is no checkpoint yet: "latest" or a number. A stored
# checkpoint always wins over this.
START_BLOCK=latest

# Kafka (local Redpanda via docker-compose). The topic is created on startup.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=tx-events
# Compacted, so it keeps one record per chain no matter how long we run.
KAFKA_CHECKPOINT_TOPIC=tx-checkpoints

# Address dataset, produced by `make dataset`.
ADDRESSES_FILE=testdata/addresses.csv

# Log level: debug | info | warn | error
LOG_LEVEL=info
