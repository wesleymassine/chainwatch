# JSON-RPC endpoint. Verified working: ethereum-rpc.publicnode.com,
# eth.drpc.org, arb1.arbitrum.io/rpc.
RPC_URL=https://ethereum-rpc.publicnode.com

# Everything below is optional. The service asks the chain for its id and picks
# the measured profile for it — mainnet and Arbitrum are both known — so these
# only exist to override a profile or to tune a chain we have not measured.
#
# How often to ask for a new head once caught up.
# POLL_INTERVAL=3s

# Concurrent fetches and blocks per fetch. Measured on mainnet: 48 blocks/s at 4
# workers, 69 at 8, 76 at 16, 74 at 32 — the endpoint saturates, not the service.
# BATCH_SIZE is bounded by the endpoint's ~24 MB response cap.
# WORKERS=8
# BATCH_SIZE=20

# How far behind the head to stay. Blocks nearer than this can still be replaced
# by a reorg, and publishing one means crediting a user for a transaction the
# chain then discards.
# CONFIRM_DEPTH=2

# Where to begin when there is no checkpoint yet: "latest" or a number. A stored
# checkpoint always wins over this.
START_BLOCK=latest

# Kafka (local Redpanda via docker-compose). The topic is created on startup.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=tx-events
# Compacted, so it keeps one record per chain no matter how long we run.
KAFKA_CHECKPOINT_TOPIC=tx-checkpoints

# Address dataset, produced by `make dataset`.
ADDRESSES_FILE=testdata/addresses.csv

# Log level: debug | info | warn | error
LOG_LEVEL=info
